<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- <test> blocks run top to bottom -->
<suite name="nithyakarma-delivery-pipeline">
<test name="regression">
    <groups>
        <run>
            <!-- T15 fails until the app bug is fixed; run it with testng-known-bugs.xml -->
            <exclude name="known-bug"/>
        </run>
    </groups>
    <packages>
        <package name="org.nithyakarma.pipeline.tests"/>
    </packages>
</test>
</suite>

