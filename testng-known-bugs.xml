<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Tests that document real, unfixed app bugs. Expected to FAIL until the app is fixed.
     Needs E2E_ALLOW_DATA_WRITES=true:  mvn test -Dsuite=testng-known-bugs.xml -->
<suite name="nithyakarma-known-bugs">
<test name="known-bugs">
    <groups>
        <run>
            <include name="known-bug"/>
        </run>
    </groups>
    <packages>
        <package name="org.nithyakarma.pipeline.tests"/>
    </packages>
</test>
</suite>
